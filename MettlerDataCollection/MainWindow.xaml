<Window x:Class="MettlerDataCollection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="梅特勒数据采集" Height="450" Width="1000" MinWidth="1000"
        Closing="MainWindow_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" VerticalAlignment="Top">
            <MenuItem Header="文件">
                <MenuItem Header="读取历史数据"/>
                <MenuItem Header="提取历史数据"/>
            </MenuItem>
            <MenuItem Header="测试连接" Click="Button_OpenTestPage"></MenuItem>
            <MenuItem Header="设置">
                <MenuItem Header="端口设置"/>
                <MenuItem Header="采集设置"/>
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于"/>
            </MenuItem>
        </Menu>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Height="auto" Margin="2">
            <TextBlock Text="选择一个端口: " VerticalAlignment="Center"/>
            <ComboBox x:Name="ComportCombox" SelectedItem="{Binding SelectedComport, Mode=TwoWay}" Width="200" 
              HorizontalAlignment="Left" >
            </ComboBox>
            <Button Content="连接" MinWidth="60" Margin="2,0,2,0" Click="Button_OpenPort"/>
            <Button Content="断开" MinWidth="60" Margin="2,0,2,0" Click="Button_ClosePort"/>
            <Border Width="1" 
                Background="Gray" 
                Margin="2,2" 
                VerticalAlignment="Stretch"/>
            <Label Content="采集模式"/>
            <ComboBox Name="CollectModeCombox" Width="95" Margin="2,0,2,0" VerticalAlignment="Center">
                <ComboBoxItem Content="pH+电导率" IsSelected="True"/>
                <ComboBoxItem Content="pH"/>
                <ComboBoxItem Content="电导率"/>

            </ComboBox>
            <Button Content="开始采集" MinWidth="60" Margin="2,0,2,0" Click="Button_StartCollect"/>
            <Button Content="停止采集" MinWidth="60" Margin="2,0,2,0" Click="Button_StopCollect"/>
            <Border Width="1" Background="Gray" Margin="2,2" VerticalAlignment="Stretch"/>
            <Label Content="数据展示方式"/>
            <RadioButton GroupName="dataview" x:Name="showFull" IsChecked="True" Content="全部" Margin="2,0,2,0" VerticalAlignment="Center"/>
            <RadioButton GroupName="dataview" x:Name="showSlide" Content="最新" Margin="2,0,2,0" VerticalAlignment="Center"/>
            <Border Width="1" Background="Gray" Margin="2,2" VerticalAlignment="Stretch"/>
            <Button Content="导出数据" MinWidth="60" Margin="2,0,2,0" Click="Button_ExportData"/>
        </StackPanel>
        <ScottPlot:WpfPlot Grid.Row="2" Height="auto" x:Name="MainPlot" />
        <StackPanel Grid.Row="3" Height="auto" Orientation="Horizontal" Margin="2">
            <Label x:Name="ComportLabel" Content="等待连接" Margin="5,0,0,0"/>
            <Label x:Name="dataCountLabel"/>
        </StackPanel>
    </Grid>
</Window>
