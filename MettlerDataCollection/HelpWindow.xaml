<Window x:Class="MettlerDataCollection.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="帮助文档"
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#FAFAFA">
    <Border Margin="10" Padding="15" Background="White" CornerRadius="10" BorderBrush="#DDD" BorderThickness="1" >
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 顶部标题 -->
                <TextBlock Text="使用帮助" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="#2D2D2D"
                           Margin="0,0,0,10" />

                <TextBlock Text="本软件用于采集梅特勒 S470 的 pH 和电导率数据。请根据以下说明正确连接与配置设备。" 
                           TextWrapping="Wrap"
                           Foreground="#555"
                           FontSize="13"
                           Margin="0,0,0,20"/>

                <!-- 工具部分 -->
                <TextBlock Text="🧰 必要工具" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Margin="0,0,0,8" />

                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,20" Background="#FCFCFC">
                    <StackPanel>
                        <TextBlock Text="• 一根 RS232 公口转 USB 线" FontSize="13" Foreground="#333"/>
                        <TextBlock Text="• 一台梅特勒 S470 仪器" FontSize="13" Foreground="#333"/>
                        <TextBlock Text="• 安装好本软件的计算机" FontSize="13" Foreground="#333"/>
                    </StackPanel>
                </Border>

                <!-- 步骤部分 -->
                <TextBlock Text="🚀 使用步骤" 
                           FontSize="16" 
                           FontWeight="Bold"
                           Margin="0,0,0,8" />

                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="10" Background="#FCFCFC">
                    <ItemsControl>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <Ellipse Width="6" Height="6" Fill="#0078D7" Margin="0,6,8,0"/>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Foreground="#333" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                        <System:String>将 RS232 转 USB 线连接到电脑和梅特勒 S470 设备上。</System:String>
                        <System:String>打开软件，选择正确的 COM 端口（可选：点击“测试连接”确保端口正确）。</System:String>
                        <System:String>在 S470 设备上，依次选择 设置 → 硬件 → 外围设备 → 打印机。</System:String>
                        <System:String>在打印机设置中，选择“RS232 紧凑型打印机”，取消勾选“自动波特率”，其他保持默认。</System:String>
                        <System:String>点击“连接”按钮建立连接。</System:String>
                        <System:String>选择采集模式（pH+电导率、pH 或 电导率）。</System:String>
                        <System:String>点击“开始采集”按钮开始数据采集。</System:String>
                        <System:String>在S470开始间隔测量方法，方法设置中务必勾选间隔后打印</System:String>
                        <System:String>点击“停止采集”结束数据采集。</System:String>
                        <System:String>点击“导出数据”按钮保存为 txt 文件。</System:String>
                    </ItemsControl>
                </Border>

                <!-- ✅ 新增 数据安全 部分 -->
                <TextBlock Text="🛡️ 数据安全" 
                           FontSize="16" 
                           FontWeight="Bold"
                           Margin="20,15,0,8" />

                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="10" Background="#FCFCFC">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="6" Height="6" Fill="#0078D7" Margin="0,6,8,0"/>
                        <TextBlock Grid.Column="1"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   Foreground="#333">
                        为避免丢失数据，在端口连接的情况下，即使未开始采集，
                        软件也会自动将串口接收到的原始消息写入程序目录下的
                        “origindata” 文件夹中。
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 底部信息 -->
                <TextBlock Text="提示：若接收不到数据，请检查串口线连接和串口设置是否一致。" 
                           TextWrapping="Wrap"
                           Foreground="#777"
                           FontStyle="Italic"
                           FontSize="12"
                           Margin="0,15,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
