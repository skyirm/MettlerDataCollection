<Window x:Class="MettlerDataCollection.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Height="400" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Background="LightBlue">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <TextBlock Text="Mettler S470 Data Collector"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"/>

        <!-- 主体内容 -->
        <StackPanel Grid.Row="1" Margin="20,0" VerticalAlignment="Center" >
            <TextBlock Text="作者：Jinrui Gao" FontSize="14" Margin="0,5"/>
            <TextBlock Text="版本：v1.0.0" FontSize="14" Margin="0,5"/>

            <!-- 项目地址 -->
            <TextBlock Text="项目地址：" FontSize="14" Margin="0,5"/>
            <TextBlock Text="https://github.com/skyirm/MettlerDataCollection"
                       FontSize="14"
                       Foreground="#0078D7"
                       TextDecorations="Underline"
                       Cursor="Hand"
                       MouseLeftButtonUp="OnLinkClick"/>

            <!-- 开源项目列表 -->
            <TextBlock Text="使用的开源项目：" FontSize="14" Margin="0,10,0,5"/>
            <ItemsControl>
                <ItemsControl.Items>
                    <TextBlock Text="• ScottPlot" FontSize="13"/>
                    <TextBlock Text="• Serilog" FontSize="13"/>
                </ItemsControl.Items>
            </ItemsControl>
        </StackPanel>

        <!-- 底部关闭按钮 -->
        <Button Grid.Row="2" Content="关闭"
                Width="80" Height="30"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Click="OnCloseClick"/>
    </Grid>
</Window>
