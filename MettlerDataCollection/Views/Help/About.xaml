<Window x:Class="MettlerDataCollection.Views.Help.About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Height="520" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        Background="#F2F5FA">

    <Border Background="White"
            Margin="20"
            CornerRadius="10"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" Opacity="0.4" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部标题 -->
            <StackPanel Grid.Row="0" Margin="0,10,0,20" HorizontalAlignment="Center">
                <TextBlock Text="Mettler S470 MeasureData Collector"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#2D2D2D"
                           HorizontalAlignment="Center" />
                <TextBlock Text="梅特勒 S470 数据采集工具"
                           FontSize="13"
                           Foreground="#666"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 主体内容 -->
            <StackPanel Grid.Row="1" Margin="30,0" VerticalAlignment="Center">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="Foreground" Value="#333" />
                        <Setter Property="Margin" Value="0,4,0,4" />
                    </Style>
                </StackPanel.Resources>

                <TextBlock Text="作者：Jinrui Gao" />
                <TextBlock Text="版本：v1.0.0" />
                <TextBlock Text="开源协议：MIT License" />

                <!-- 项目地址 -->
                <TextBlock Text="项目地址：" Margin="0,10,0,3" FontWeight="Bold" />
                <TextBlock Text="https://github.com/skyirm/MettlerDataCollection"
                           FontSize="13"
                           Foreground="#0078D7"
                           Cursor="Hand"
                           TextDecorations="Underline"
                           MouseLeftButtonUp="OnLinkClick" />

                <!-- 使用的开源项目 -->
                <TextBlock Text="使用的开源项目：" Margin="0,15,0,5" FontWeight="Bold" />
                <ItemsControl>
                    <ItemsControl.Items>
                        <TextBlock Text="• ScottPlot" FontSize="13" />
                        <TextBlock Text="• Serilog" FontSize="13" />
                    </ItemsControl.Items>
                </ItemsControl>
            </StackPanel>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Center">
                <Button Content="关闭"
                        Width="100" Height="32"
                        Background="#0078D7"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="OnCloseClick"
                        Cursor="Hand"
                        Padding="5,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#0078D7" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#005A9E" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>