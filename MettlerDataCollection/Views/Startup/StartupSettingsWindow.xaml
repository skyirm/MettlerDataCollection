<Window x:Class="MettlerDataCollection.Views.Startup.StartupSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="启动设置"
        Height="280" Width="600"
        MinWidth="500" MinHeight="280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 第 1 行：数据存放路径（ShowDataPath=false 时整行隐藏） -->
        <Grid x:Name="DataPathRow" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="数据存放路径:" VerticalAlignment="Center" />
            <TextBox x:Name="DataPathTextBox" Grid.Column="1" VerticalAlignment="Center"
                     Padding="6,4" Margin="0,0,8,0"
                     TextChanged="DataPathTextBox_TextChanged" />
            <Button Grid.Column="2" Content="选择目录..." MinWidth="90" Padding="8,4"
                    Click="BrowseButton_Click" />
        </Grid>

        <!-- 第 2 行：设备选择 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="仪器设备:" VerticalAlignment="Center" />
            <ComboBox x:Name="DeviceComboBox" Grid.Column="1" VerticalAlignment="Center"
                      Padding="6,4" SelectionChanged="DeviceComboBox_SelectionChanged" />
        </Grid>

        <!-- 第 3 行：确认/取消 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="确认" MinWidth="100" Padding="12,6" Margin="0,0,8,0"
                    IsDefault="True" Click="OkButton_Click" />
            <Button x:Name="CancelButton" Content="取消" MinWidth="100" Padding="12,6"
                    IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
