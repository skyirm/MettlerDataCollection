<Window x:Class="MettlerDataCollection.Views.Recovery.RecoverData"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MettlerDataCollection"
        xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="导出历史数据" 
        Height="500" Width="900"
        Background="#F5F6FA">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" 
                Background="White"
                CornerRadius="8"
                Padding="10"
                Margin="0 0 0 10"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                >
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" >

                <!-- 显示文件名的区域 -->
                <Border Background="#FAFAFA"
                        Padding="6 4"
                        CornerRadius="6"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="FileNameText"
                               Width="300"
                               Foreground="#444"
                               Text="未选择文件"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- 采集模式固定为 pH + 电导率双工，不再提供选择 -->

                <!-- 文件按钮 -->
                <Button Content="选择文件"
                        Click="ReadFile"
                        Width="90"
                        Padding="4"

                        BorderThickness="1"/>

                <Button Content="导出数据"
                        Click="ExportData"
                        Width="90"
                        Padding="4"

                        BorderThickness="1"/>
            </StackPanel>
        </Border>

        <!-- 主图表 -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="8"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <scottPlot:WpfPlot x:Name="MainPlot"/>
        </Border>

    </Grid>
</Window>
