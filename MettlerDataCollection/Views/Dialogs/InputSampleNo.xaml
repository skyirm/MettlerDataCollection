<Window x:Class="MettlerDataCollection.Views.Dialogs.InputSampleNo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="SingleBorderWindow">
    <StackPanel Margin="20">
        <TextBlock x:Name="tipsTextBlock" Margin="0,0,0,10"/>
        <TextBox x:Name="InputBox" Width="250" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Width="75" Margin="5" IsDefault="True" Click="Ok_Click"/>
            <Button Content="取消" Width="75" Margin="5" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>