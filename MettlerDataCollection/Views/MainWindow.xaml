<Window x:Class="MettlerDataCollection.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:controls="clr-namespace:MettlerDataCollection.Views.Controls"
        Title="梅特勒S470数据采集" Height="450" Width="1100" MinWidth="700"
        Closing="MainWindow_Closing" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" VerticalAlignment="Top">
            <MenuItem Header="文件">
                <MenuItem Header="导出历史数据" Click="Button_ReadOrigindata" />
            </MenuItem>
            <MenuItem Header="测试连接" Click="Button_OpenTestPage" />
            <MenuItem Header="设置">
                <MenuItem Header="串口设置" Click="Button_OpenPortSetting" />
                <MenuItem Header="采集设置" Click="Button_SampleSetting" />
                <MenuItem Header="重新选择设备..." Click="Button_OpenDeviceSelection" />
            </MenuItem>
            <MenuItem Header="关于">
                <MenuItem Header="操作指南" Click="Button_OpenOperationGuide" />
                <MenuItem Header="帮助" Click="Button_OpenHelp" />
                <MenuItem Header="更新日志" Click="Button_OpenUpdateLog" />
                <MenuItem Header="关于" Click="Button_OpenAbout" />
            </MenuItem>
        </Menu>
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Height="auto" VerticalAlignment="Center" Margin="2">
            <TextBlock Text="选择一个端口: " VerticalAlignment="Center" />
            <ComboBox x:Name="ComportCombox" SelectedItem="{Binding SelectedComport, Mode=TwoWay}" Width="200"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      ToolTip="选择与 S470 相连的 COM 端口；列表会在设备插拔后自动刷新。" />
            <Button x:Name="Btn_OpenPort" Content="连接" MinWidth="60" Margin="2,0,2,0" Click="Button_OpenPort"
                    VerticalAlignment="Center" ToolTip="打开所选串口并连接设备。" />
            <Button x:Name="Btn_ClosePort" IsEnabled="False" Content="断开" MinWidth="60" Margin="2,0,2,0"
                    Click="Button_ClosePort" VerticalAlignment="Center" ToolTip="关闭当前串口连接。" />
            <Border Width="1"
                    Background="Gray"
                    Margin="2,2"
                    VerticalAlignment="Stretch" />
            <Label Content="采集模式" VerticalAlignment="Center" />
            <ComboBox Name="CollectModeCombox" Width="100" Margin="2,0,2,0" VerticalAlignment="Center"
                      ToolTip="选择与仪器输出一致的数据类型，否则曲线可能无法正确解析。">
                <ComboBoxItem Content="pH+电导率" IsSelected="True" />
                <ComboBoxItem Content="pH" />
                <ComboBoxItem Content="电导率" />
            </ComboBox>
            <Button x:Name="Btn_StartCollect" Content="开始采集" MinWidth="60" Margin="2,0,2,0"
                    Click="Button_StartCollect" ToolTip="输入样品编号，清空当前曲线并开始记录新实验。" />
            <Button x:Name="Btn_StopCollect" IsEnabled="False" Content="停止采集" MinWidth="60" Margin="2,0,2,0"
                    Click="Button_StopCollect" ToolTip="停止更新曲线；已接收的原始数据仍保存在数据目录。" />
            <Border Width="1" Background="Gray" Margin="2,2" VerticalAlignment="Stretch" />
            <Button Content="自动缩放" MinWidth="72" Margin="2,0,2,0" Click="Button_AutoScale"
                    ToolTip="让坐标轴立即适配当前全部数据。" />
            <Border Width="1" Background="Gray" Margin="2,2" VerticalAlignment="Stretch" />
            <Button Content="导出数据" MinWidth="60" Margin="2,0,2,0" Click="Button_ExportData"
                    ToolTip="将当前曲线数据导出为文本文件。" />
        </WrapPanel>
        <Border Grid.Row="2" Background="#F4F8FC" BorderBrush="#D5E5F2" BorderThickness="0,1"
                Padding="8,5" Margin="0,2,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock Text="提示" FontWeight="SemiBold" Foreground="#0F6CBD" Margin="0,0,10,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="OperationHintText" Foreground="#3B4A5A" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <scottPlot:WpfPlot Grid.Row="3" Margin="3" Height="auto" x:Name="MainPlot"
                           ToolTip="左键平移，中键框选，右键缩放。" />
        <StackPanel Grid.Row="4" Height="auto" Orientation="Horizontal" Margin="2" VerticalAlignment="Center">
            <Label x:Name="ComportLabel" Content="等待连接" Margin="2,0" VerticalAlignment="Center" />
            <Label x:Name="SampleNoLabel" Content="样品编号：" Margin="2,0" VerticalAlignment="Center" />
            <Button Content="修改编号" Margin="5,2,0,2" Click="Button_ModifySampleNo" VerticalAlignment="Center" />
            <Label x:Name="dataCountLabel" Margin="2,0" VerticalAlignment="Center" />
            <Label x:Name="UserViewHint" Margin="2,0" VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>
        <controls:ErrorLog Grid.Row="4" x:Name="ErrorLog" HorizontalAlignment="Right"
                           Margin="0,2,8,2" VerticalAlignment="Center" />
    </Grid>
</Window>
