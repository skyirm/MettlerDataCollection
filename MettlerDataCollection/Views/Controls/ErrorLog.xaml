<UserControl x:Class="MettlerDataCollection.Views.Controls.ErrorLog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="40" d:DesignWidth="120">
    <Grid>
        <Button x:Name="BadgeButton" Content="⚠ 错误日志" Padding="8,3" Click="BadgeButton_Click"
                ToolTip="打开错误日志" />
        <Popup x:Name="LogPopup" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="White" BorderBrush="#B8C0CC" BorderThickness="1" Padding="8"
                    Width="620" MaxHeight="460" CornerRadius="6">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="关闭" Padding="8,3" Click="ClosePopup_Click" />
                        <Button DockPanel.Dock="Right" Content="弹出窗口" Padding="8,3" Margin="0,0,6,0" Click="OpenWindow_Click" />
                        <Button DockPanel.Dock="Right" Content="清空" Padding="8,3" Margin="0,0,6,0" Click="ClearButton_Click" />
                        <TextBlock Text="错误日志" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="EntryList" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling" />
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
