<Window x:Class="MettlerDataCollection.Views.Controls.ErrorLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="错误日志" Width="820" Height="520" MinWidth="560" MinHeight="260"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <CheckBox x:Name="TopmostCheckBox" DockPanel.Dock="Right" Content="置顶" Margin="8,0,0,0"
                      VerticalAlignment="Center" Checked="TopmostChanged" Unchecked="TopmostChanged" />
            <Button DockPanel.Dock="Right" Content="清空" Padding="10,4" Click="ClearButton_Click" />
            <TextBlock Text="错误日志" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox x:Name="EntryList" FontFamily="Consolas" FontSize="13"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling" />
    </DockPanel>
</Window>
