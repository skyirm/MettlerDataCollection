<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    离线 fallback：nuget.org 不可达时，restore 会回退到本地缓存
    （%USERPROFILE%\.nuget\packages）和 VS 自带的 NuGetPackages。
    在线时 nuget.org 优先，行为没变化。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-cache" value="C:\Users\gjr\.nuget\packages" />
    <add key="vs-offline" value="C:\Program Files (x86)\Microsoft SDKs\NuGetPackages" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
